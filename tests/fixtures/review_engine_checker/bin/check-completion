#!/usr/bin/env python3
"""Stdlib-only completion checker fixture for cw tests (#3885).

Writes a complete ``result.json`` bound to --head-sha, --round-id and --roles
when HEAD matches, and a sibling ``observed.json`` the tests read. No clock, no
randomness.
"""

import json
import os
import subprocess
import sys
from pathlib import Path


def _arg(name: str) -> str:
    index = sys.argv.index(name)
    return sys.argv[index + 1]


def main() -> int:
    head_sha = _arg("--head-sha")
    round_id = _arg("--round-id")
    worktree = _arg("--worktree")
    evidence = Path(_arg("--evidence-dir"))
    roles = _arg("--roles").split(",")
    observed = {
        "argv": sys.argv[1:],
        "cwd": str(Path.cwd()),
        "env_keys": sorted(os.environ),
        "tmpdir": os.environ.get("TMPDIR"),
    }
    (evidence / "observed.json").write_text(json.dumps(observed), encoding="utf-8")
    actual = subprocess.run(
        ["git", "-C", worktree, "rev-parse", "HEAD"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    status = "complete" if actual == head_sha else "failed"
    result = {
        "schema": 1,
        "head_sha": head_sha,
        "round_id": round_id,
        "status": status,
        "roles_covered": roles,
        "detail": "fixture checker",
    }
    (evidence / "result.json").write_text(json.dumps(result), encoding="utf-8")
    return 0 if status == "complete" else 1


if __name__ == "__main__":
    sys.exit(main())
